# Copy to android/keystore.properties (gitignored) and fill in.
# Every value can also come from an environment variable, which wins over this file:
#   MYSIMOKA_UPLOAD_STORE_FILE, MYSIMOKA_UPLOAD_STORE_PASSWORD,
#   MYSIMOKA_UPLOAD_KEY_ALIAS, MYSIMOKA_UPLOAD_KEY_PASSWORD
#
# storeFile is relative to this android/ folder, or an absolute path.
# Prefer keeping the .jks OUTSIDE the repo, e.g. D:/Kunci/mysimoka-upload.jks
# (use forward slashes on Windows).
storeFile=D:/Kunci/mysimoka-upload.jks
storePassword=GANTI_DENGAN_PASSWORD_KEYSTORE
keyAlias=mysimoka-upload
keyPassword=GANTI_DENGAN_PASSWORD_KEY
